# vendor/ and node_modules/ are rebuilt in the vendor/assets stages from
# composer.lock/package-lock.json — never copy a local one into the build
# context, and excluding it here is what forces the Dockerfile to use the
# copy-from-stage pattern instead of quietly trusting whatever happens to be
# on disk.
/vendor
/node_modules

.git
.github

# Secrets: never let a local .env reach the build context. Runtime config
# comes entirely from the Dokploy panel — see DEPLOY.md.
.env
.env.*
!.env.example

# Local build/test artifacts — irrelevant to the image and would bust layer
# caching for no reason if included.
/public/build
/public/hot

# Generated by a LOCAL `composer install`, which (unlike the image's --no-dev
# one) has dev packages present — a stale copy here would make Laravel try
# to register a provider class (e.g. Laravel\Pail\PailServiceProvider) that
# doesn't exist in the image's vendor/, crashing every request. The
# Dockerfile regenerates and copies in the correct one explicitly.
/bootstrap/cache/*.php
!/bootstrap/cache/.gitignore

/storage/*.key
/storage/logs/*.log
/storage/framework/cache/data/*
/storage/framework/sessions/*
/storage/framework/testing/*
/storage/framework/views/*
!storage/framework/cache/data/.gitignore
!storage/framework/sessions/.gitignore
!storage/framework/testing/.gitignore
!storage/framework/views/.gitignore
*.log
.phpunit.result.cache
.phpunit.cache

/tests

# Docs and editor/IDE metadata — never needed inside the image.
*.md
.editorconfig
.gitattributes
.idea
.vscode
.zed
.nova
.DS_Store

# Local dev / non-production compose files never belong in the image either.
compose.local.yaml
